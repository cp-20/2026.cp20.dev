{
  "name": "2026.cp20.dev",
  "type": "module",
  "scripts": {
    "build:client": "vite build --config client/vite.config.ts",
    "dev:client": "vite build --watch --config client/vite.config.ts",
    "dev:server": "wrangler dev --port 8787",
    "dev": "concurrently -k -n server,client -c cyan,magenta \"bun run dev:server\" \"bun run dev:client\"",
    "predeploy": "bun run build:client",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "hono": "^4.12.9",
    "jimp": "^1.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@xterm/addon-clipboard": "^0.2.0",
    "concurrently": "^9.2.1",
    "sixel": "^0.16.0",
    "valibot": "^1.3.1",
    "vite": "^8.0.3",
    "wrangler": "^4.79.0"
  }
}
