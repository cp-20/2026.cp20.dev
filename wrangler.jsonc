{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "2026-portfolio",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-27",
  "assets": {
    "directory": "client/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/articles",
      "/featured-series",
      "/featured-tracks",
      "/works",
      "/works/*",
    ],
  },
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
